# Raiz del reactor: Lombok no busca mas arriba de este archivo
config.stopBubbling = true

# @RequiredArgsConstructor copia estas anotaciones del campo al parametro del constructor.
# Sin esto, un @Lazy o un @Qualifier sobre el campo se pierde al generar el constructor
# y Spring falla al resolver la dependencia (por ejemplo, el ciclo AuthService <-> ContextoDeEmpresa).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
